# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
coverage/
*.tsbuildinfo

# Runtime artifacts
*.log
.tmp/
tmp/

# Update package artifacts
update/dist/
update/hosted/archives/*.zip

# OS/editor files
.DS_Store
Thumbs.db
.vscode/

# Local environment files
.env
.env.*
!.env.example

# SSH and security secrets
.ssh/
**/.ssh/
**/id_*
**/*.pem
**/*.key
**/*.pub
**/authorized_keys
**/known_hosts

# Keep cloned Otto repositories but ignore nested git metadata
external/otto/**/.git/
