{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DisplayCalendarFeed",
  "type": "object",
  "required": ["generatedAt", "events"],
  "properties": {
    "generatedAt": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "startsAt", "endsAt", "source"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "startsAt": { "type": "string" },
          "endsAt": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    }
  }
}
